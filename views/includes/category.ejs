<div class="category-section">

    <label for="category-inp" class="form-label show-category">Choose Category</label>
    <div class="category-input-wrapper">
        <input type="text" class="form-control " id="category-inp" placeholder="Choose Category" readonly>

        <i class="fa-solid fa-chevron-down category-arrow"></i>
    </div>


    <div class="category-Wrapper" id="category">
        <div class="category-box">

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Iconic-cities" value="Iconic Cities">
                <label for="Iconic-cities"><i class="fa-solid fa-city"></i>Iconic Cities</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Rooms" value="Rooms">
                <label for="Rooms"><i class="fa-solid fa-bed"></i>Rooms</label>
            </div>

            

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Mountains" value="Mountains">
                <label for="Mountains"><i class="fa-solid fa-mountain"></i>Mountains</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Castle" value="Castle">
                <label for="Castle"><i class="fa-brands fa-fort-awesome"></i>Castle</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Beaches" value="Beaches">
                <label for="Beaches"><i class="fa-solid fa-umbrella-beach"></i>Beaches</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Arctic" value="Arctic">
                <label for="Arctic"><i class="fa-solid fa-snowman"></i>Arctic</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Heritage" value="Heritage">
                <label for="Heritage"><i class="fa-solid fa-landmark"></i>Heritage</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Lake-front" value="Lake Front">
                <label for="Lake-front"><i class="fa-solid fa-water"></i>Lake Front</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Tiny-homes" value="Tiny Homes">
                <label for="Tiny-homes"><i class="fa-solid fa-house-chimney-window"></i>Tiny Homes</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Vineyards-tasting" value="Vineyards & Tasting">
                <label for="Vineyards-tasting"><i class="fa-solid fa-wine-glass"></i>Vineyards</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Pools-swimming" value="Pools & Swimming">
                <label for="Pools-swimming"><i class="fa-solid fa-person-swimming"></i>Pools</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Skiing-snow" value="Skiing & Snow">
                <label for="Skiing-snow"><i class="fa-solid fa-person-skiing"></i>Skiing</label>
            </div>

            <div class="category-option">
                <input type="checkbox" name="listing[category]" id="Hiking-trails" value="Hiking & Trails">
                <label for="Hiking-trails"><i class="fa-solid fa-person-hiking"></i>Hiking</label>
            </div>

        </div>
    </div>
</div>