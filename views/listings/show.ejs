<% layout('/layouts/boilerplate') -%>

<script>
    const mapApi = "<%= process.env.MAPTILER_API_KEY %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

    <body>
        <div class="container my-4">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="card show-card border-0 shadow-sm">
                        <div class="card-body p-3 p-md-4">
                            <h3 class="card-title mb-3">
                                <%= listing.title %>
                            </h3>

                            <div class="show-img-wrapper mb-3">
                                <img src="<%= listing.image.url %>" class="img-fluid show-img" alt="listing_image">

                                <div class="heart-overlay">
                                    <div class="heart-button">

                                        <% const isWishlisted=currUser && listing.wishlistUsers?.some( user=>
                                            user.toString() === currUser._id.toString()
                                            );
                                            %>

                                            <% if (isWishlisted) { %>
                                                <i class="fa-solid fa-heart"></i>
                                                <span class="tool-tip">Added to Wishlist</span>
                                                <% } else { %>
                                                    <i class="fa-regular fa-heart"></i>
                                                    <span class="tool-tip">Add to Wishlist</span>
                                                    <% } %>

                                    </div>
                                </div>


                                <p class="card-text">Owned by <b><i>
                                            <%= listing.owner.username %>
                                        </i></b></p>
                                <p class="card-text">
                                    <%= listing.description %>
                                </p>
                                <p class="card-text">
                                    <%= listing.location %>
                                </p>
                                <p class="card-text">
                                    <%= listing.country %>
                                </p>
                                <p class="card-text fw-bold text-dark fs-5">
                                    &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                                </p>

                                <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
                                    <div class="d-flex gap-2 mt-3">
                                        <a href="/listings/<%= listing._id %>/edit"
                                            class="btn btn-dark show-btns">Edit</a>
                                        <button type="button" onclick="showPopUp()"
                                            class="btn btn-danger show-btns">Delete</button>
                                    </div>

                                    <!-- Delete Confirmation Overlay -->
                                    <div class="pop-up">
                                        <div class="pop-up-box">
                                            <h4>Delete Listing?</h4>
                                            <p>Are you sure you want to delete this listing? This action cannot be
                                                undone.</p>
                                            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                                                <div class="button-group d-flex justify-content-end gap-2 mt-3">
                                                    <button type="button" onclick="closePopUp()"
                                                        class="btn btn-secondary">Cancel</button>
                                                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                    <% } %>

                                        <% if(currUser){ %>
                                            <hr class="my-4">
                                            <div class="mt-2">
                                                <h3>Rate this place</h3>
                                                <form action="/listings/<%= listing._id %>/reviews" method="post">
                                                    <label class="form-label mt-2">Rating</label>
                                                    <fieldset class="starability-slot">
                                                        <input type="radio" id="no-rate" class="input-no-rate"
                                                            name="review[rating]" value="0" checked
                                                            aria-label="No rating." />
                                                        <input type="radio" id="first-rate1" name="review[rating]"
                                                            value="1" />
                                                        <label for="first-rate1" title="Terrible">1 star</label>
                                                        <input type="radio" id="first-rate2" name="review[rating]"
                                                            value="2" />
                                                        <label for="first-rate2" title="Not good">2 stars</label>
                                                        <input type="radio" id="first-rate3" name="review[rating]"
                                                            value="3" />
                                                        <label for="first-rate3" title="Average">3 stars</label>
                                                        <input type="radio" id="first-rate4" name="review[rating]"
                                                            value="4" />
                                                        <label for="first-rate4" title="Very good">4 stars</label>
                                                        <input type="radio" id="first-rate5" name="review[rating]"
                                                            value="5" />
                                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                                    </fieldset>

                                                    <div class="mb-3">
                                                        <label for="comment" class="form-label">Comment</label>
                                                        <textarea class="form-control" rows="4" id="comment"
                                                            name="review[comment]" required></textarea>
                                                    </div>
                                                    <button type="submit" class="btn btn-outline-dark">Submit</button>
                                                </form>
                                            </div>
                                            <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% if(listing.reviews.length>0) {%>
                <hr>
                <h4 class="mt-2">Reviews & Ratings</h4>
                <div class="row  row-cols-lg-3 row-cols-md-2 row-cols-sm-1 gx-4 mb-3">
                    <% for (review of listing.reviews) {%>
                        <div class="col">
                            <div class="card mb-3">
                                <div class="card-header">@<b><i>
                                            <%= review.author.username %>
                                        </i></b></div>
                                <div class="card-body">
                                    <p class="starability-result" data-rating="<%= review.rating %>"></p>
                                    <p class="card-text">
                                        <%=review.comment%>
                                    </p>
                                    <form method="post" class="mb-1"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <% if(currUser && currUser._id.equals(review.author._id || review.author)){ %>
                                        <button class=" btn btn-xs btn-dark">Delete</button>
                                        <% } %>
                                    </form>

                                </div>
                            </div>

                        </div>
                        <% } %>
                </div>
                <% } %>
        </div>


        <!-- Map Section -->
        <div class="container my-4">
            <div class="row justify-content-center mt-4">
                <div class="col-12 col-md-8 col-lg-6 mb-4">
                    <h4 class="mb-3">Where you'll be</h4>
                    <div id="map"></div>
                </div>
            </div>
        </div>
        </div>

    </body>